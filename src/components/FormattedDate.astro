---
interface Props {
	date: Date;
}

const { date } = Astro.props;

// Frontmatter dates are parsed as UTC midnight, so format in UTC to keep the
// same day in every time zone.
const label = date.toLocaleDateString("en-US", {
	year: "numeric",
	month: "short",
	day: "numeric",
	timeZone: "UTC",
});
---

<time datetime={date.toISOString()}>{label}</time>

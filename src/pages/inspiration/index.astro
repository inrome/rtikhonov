---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("inspiration")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

function formatDate(date: Date) {
	return date.toLocaleDateString("en-US", {
		year: "numeric",
		month: "short",
		day: "numeric",
	});
}
---

<BaseLayout
	title="Inspiration — Roman Tikhonov"
	description="Notes and ideas that stay with me."
	currentPath="/inspiration"
>
	<header>
		<h1>Inspiration</h1>
		<p class="lede">Notes and ideas that stay with me.</p>
	</header>

	{
		posts.length === 0 ? (
			<p class="empty">No posts yet.</p>
		) : (
			<ul class="posts">
				{posts.map((post) => (
					<li>
						<a href={`/inspiration/${post.id}`}>{post.data.title}</a>
						<span class="meta">
							<time datetime={post.data.pubDate.toISOString()}>
								{formatDate(post.data.pubDate)}
							</time>
						</span>
						<p>{post.data.description}</p>
					</li>
				))}
			</ul>
		)
	}
</BaseLayout>

<style>
	header {
		margin-bottom: 2.5rem;
	}

	h1 {
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem;
	}

	.lede {
		margin: 0;
		color: var(--muted);
	}

	.empty {
		color: var(--muted);
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.posts li {
		padding: 0 0 1.75rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 1.75rem;
	}

	.posts li:last-child {
		border-bottom: none;
		margin-bottom: 0;
		padding-bottom: 0;
	}

	.posts a {
		font-size: 1.125rem;
		font-weight: 600;
		letter-spacing: -0.01em;
	}

	.meta {
		display: block;
		margin: 0.35rem 0 0.5rem;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.posts p {
		margin: 0;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>

---
import { render } from "astro:content";
import FormattedDate from "../../components/FormattedDate.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";
import { INSPIRATION_TITLE } from "../../consts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getInspirationPosts, type InspirationPost } from "../../lib/inspiration";

export async function getStaticPaths() {
	const posts = await getInspirationPosts();
	return posts.map((post) => ({
		params: { id: post.id },
		props: post,
	}));
}

type Props = InspirationPost;

const post = Astro.props;
const { title, description, pubDate, updatedDate, sourceUrl, sourceTitle } = post.data;
const { Content } = await render(post);
---

<BaseLayout title={title} description={description}>
	<article>
		<header>
			<p class="back"><a href="/inspiration/">← {INSPIRATION_TITLE}</a></p>
			<h1>{title}</h1>
			<p class="meta">
				<FormattedDate date={pubDate} />
				{
					updatedDate && (
						<span class="updated">
							Updated <FormattedDate date={updatedDate} />
						</span>
					)
				}
			</p>
		</header>

		{
			sourceUrl && (
				<figure class="source">
					<YouTubeEmbed url={sourceUrl} title={sourceTitle ?? title} />
					<figcaption>
						Source:{" "}
						<a href={sourceUrl} rel="noopener noreferrer" target="_blank">
							{sourceTitle ?? sourceUrl}
						</a>
					</figcaption>
				</figure>
			)
		}

		<div class="body">
			<Content />
		</div>
	</article>
</BaseLayout>

<style>
	.back {
		margin: 0 0 1.25rem;
		font-size: 0.95rem;
	}

	h1 {
		font-size: 1.75rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		margin: 0 0 0.5rem;
	}

	.meta {
		margin: 0 0 2rem;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.updated {
		margin-left: 0.5rem;
	}

	.source {
		margin: 0 0 2rem;
	}

	.source figcaption {
		margin-top: 0.75rem;
		font-size: 0.875rem;
		color: var(--muted);
	}

	.body :global(h2),
	.body :global(h3) {
		font-weight: 600;
		letter-spacing: -0.01em;
		margin: 2rem 0 0.75rem;
	}

	.body :global(h2) {
		font-size: 1.25rem;
	}

	.body :global(h3) {
		font-size: 1.05rem;
	}

	.body :global(p) {
		margin: 0 0 1.25rem;
		font-size: 1.05rem;
		line-height: 1.65;
	}

	.body :global(ul),
	.body :global(ol) {
		margin: 0 0 1.25rem;
		padding-left: 1.25rem;
	}

	.body :global(li) {
		margin-bottom: 0.5rem;
		line-height: 1.65;
	}

	.body :global(blockquote) {
		margin: 0 0 1.25rem;
		padding-left: 1rem;
		border-left: 2px solid var(--border);
		color: var(--muted);
	}

	.body :global(hr) {
		margin: 2rem 0;
		border: none;
		border-top: 1px solid var(--border);
	}

	.body :global(img) {
		max-width: 100%;
		height: auto;
	}

	.body :global(:last-child) {
		margin-bottom: 0;
	}
</style>

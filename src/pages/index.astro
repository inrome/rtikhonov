---
import "@fontsource-variable/geist/wght.css";

const name = "Roman Tikhonov";
const tagline = "Product Manager · Onboarding & Identity";

const links = [
	{
		label: "LinkedIn",
		href: "https://www.linkedin.com/in/romantikhonov/",
		icon: "linkedin",
	},
	{
		label: "Telegram",
		href: "https://t.me/rvtikhonov",
		icon: "telegram",
	},
];

type Role = {
	title: string;
	note?: string;
	dates: string;
};

type WorkItem = {
	org: string;
	mark: string;
	roles: Role[];
	href?: string;
};

const latest: WorkItem[] = [
	{
		org: "payme",
		mark: "pm",
		roles: [
			{
				title: "Product Manager",
				note: "Onboarding & Identity · Tashkent",
				dates: "2025 –",
			},
		],
	},
	{
		org: "ReviewLab",
		mark: "rl",
		href: "https://reviewlab.app",
		roles: [
			{
				title: "Co-founder",
				note: "Product feedback platform",
				dates: "2024",
			},
		],
	},
];

const earlier: WorkItem[] = [
	{
		org: "HumanteQ",
		mark: "hq",
		roles: [{ title: "Product Manager", note: "Mental health tech", dates: "2023" }],
	},
	{
		org: "Carnegie Mellon",
		mark: "cm",
		roles: [
			{
				title: "Postdoctoral Fellow",
				note: "Cognitive science · Pittsburgh",
				dates: "2022",
			},
		],
	},
	{
		org: "JetBrains Research",
		mark: "jb",
		roles: [{ title: "Researcher", dates: "2021" }],
	},
	{
		org: "St. Petersburg University",
		mark: "sp",
		roles: [
			{ title: "PhD, Psychology", dates: "2021" },
			{ title: "Researcher", note: "20+ peer-reviewed papers", dates: "2015 – 22" },
		],
	},
	{
		org: "HSE University",
		mark: "hs",
		roles: [
			{
				title: "Senior Lecturer",
				note: "4 award-winning courses",
				dates: "2018 – 21",
			},
		],
	},
	{
		org: "UsabilityLab",
		mark: "ul",
		roles: [
			{
				title: "Market Research Analyst",
				note: "Mobile banking feature studies",
				dates: "2016",
			},
		],
	},
];

const misc = [
	{
		year: "2022",
		title: "Published in MIT’s Open Mind",
		source: "Pattern learning research",
	},
	{
		year: "2021",
		title: "“Best Teacher” award",
		source: "HSE University",
	},
	{
		year: "2015",
		title: "Master’s in Cognitive Psychology",
		source: "With distinction",
	},
	{
		year: "2013",
		title: "Bachelor’s in Psychology",
		source: "St. Petersburg University",
	},
	{
		year: "2012",
		title: "Exchange semester",
		source: "University of Eastern Finland",
	},
	{
		year: "2010",
		title: "Human rights education project",
		source: "AIESEC · 14 volunteers",
	},
	{
		year: "2009",
		title: "Vocational training in web development",
		source: "Then psychology",
	},
	{
		year: "1992",
		title: "Born in Kryvyi Rih, Ukraine",
		source: "",
	},
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={`${name} — ${tagline}`} />
		<meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
		<meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0a0a0a" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="generator" content={Astro.generator} />
		<title>{name}</title>
	</head>
	<body>
		<main>
			<div class="page">
				<header class="reveal" style="--reveal-delay: 0ms">
					<h1>{name}</h1>
					<p class="tagline">{tagline}</p>
				</header>

				<div class="sections">
					<section class="reveal" style="--reveal-delay: 80ms" aria-label="Latest">
						<h2>Latest</h2>
						<ul class="work-list">
							{
								latest.map((item) => (
									<li>
										{item.href ? (
											<a class="work-item is-link" href={item.href} rel="noopener noreferrer" target="_blank">
												<span class="org">
													<span class="mark" aria-hidden="true">
														{item.mark}
													</span>
													<span class="org-name">{item.org}</span>
												</span>
												<span class="roles">
													{item.roles.map((role) => (
														<span class="role-row">
															<span class="role-main">
																<span class="role-title">{role.title}</span>
																{role.note ? <span class="role-note">{role.note}</span> : null}
															</span>
															<span class="dates">{role.dates}</span>
														</span>
													))}
												</span>
												<span class="arrow" aria-hidden="true">
													<svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
														<path d="M5 12h14" />
														<path d="M13 18l6-6" />
														<path d="M13 6l6 6" />
													</svg>
												</span>
											</a>
										) : (
											<div class="work-item">
												<span class="org">
													<span class="mark" aria-hidden="true">
														{item.mark}
													</span>
													<span class="org-name">{item.org}</span>
												</span>
												<span class="roles">
													{item.roles.map((role) => (
														<span class="role-row">
															<span class="role-main">
																<span class="role-title">{role.title}</span>
																{role.note ? <span class="role-note">{role.note}</span> : null}
															</span>
															<span class="dates">{role.dates}</span>
														</span>
													))}
												</span>
											</div>
										)}
									</li>
								))
							}
						</ul>
					</section>

					<section class="reveal muted-section" style="--reveal-delay: 160ms" aria-label="Earlier">
						<h2>Earlier</h2>
						<ul class="work-list">
							{
								earlier.map((item) => (
									<li>
										<div class="work-item">
											<span class="org">
												<span class="mark" aria-hidden="true">
													{item.mark}
												</span>
												<span class="org-name">{item.org}</span>
											</span>
											<span class="roles">
												{item.roles.map((role) => (
													<span class="role-row">
														<span class="role-main">
															<span class="role-title">{role.title}</span>
															{role.note ? <span class="role-note">{role.note}</span> : null}
														</span>
														<span class="dates">{role.dates}</span>
													</span>
												))}
											</span>
										</div>
									</li>
								))
							}
						</ul>
					</section>

					<section class="reveal muted-section" style="--reveal-delay: 240ms" aria-label="Misc">
						<h2>Misc</h2>
						<ul class="misc-list">
							{
								misc.map((entry) => (
									<li>
										<span class="misc-year">{entry.year}</span>
										<span class="misc-body">
											<span class="misc-title">{entry.title}</span>
											{entry.source ? <span class="misc-source">{entry.source}</span> : null}
										</span>
									</li>
								))
							}
						</ul>
					</section>
				</div>

				<nav class="dock reveal" style="--reveal-delay: 320ms" aria-label="Links">
					<div class="dock-group">
						{
							links.map((link) => (
								<a
									href={link.href}
									rel="noopener noreferrer"
									target="_blank"
									aria-label={link.label}
									title={link.label}
								>
									{link.icon === "linkedin" ? (
										<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M8 11v5" />
											<path d="M8 8v.01" />
											<path d="M12 16v-5" />
											<path d="M16 16v-3a2 2 0 1 0-4 0" />
											<path d="M3 7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4v10a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4z" />
										</svg>
									) : (
										<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.85" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
											<path d="M21 10.7c0-4.2-4-7.7-9-7.7s-9 3.4-9 7.7c0 3.8 3.2 7 7.5 7.6 1.1.2.9.6.7 2.1-.04.2-.18.9.78.5.96-.4 5.2-3.2 7.1-5.5 1.3-1.5 1.9-3 1.9-4.7z" />
										</svg>
									)}
								</a>
							))
						}
					</div>
				</nav>
			</div>
		</main>
	</body>
</html>

<style is:global>
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	:root {
		color-scheme: light dark;
		--background-rgb: 255 255 255;
		--bg: #ffffff;
		--fg: #1a1a1a;
		--muted: #8a8a8a;
		--border: #ebebeb;
		--accent-hover: color-mix(in srgb, var(--fg) 5%, transparent);
		--page-margin: 1rem;
		--max: 42rem;
	}

	@media (min-width: 640px) {
		:root {
			--page-margin: 1.5rem;
		}
	}

	@media (prefers-color-scheme: dark) {
		:root {
			--background-rgb: 10 10 10;
			--bg: #0a0a0a;
			--fg: #f2f2f2;
			--muted: #8f8f8f;
			--border: rgb(255 255 255 / 0.1);
			--accent-hover: color-mix(in srgb, var(--fg) 6%, transparent);
		}
	}

	html {
		font-family:
			"Geist Variable",
			ui-sans-serif,
			system-ui,
			sans-serif;
		font-weight: 400;
		line-height: 1.5;
		background: var(--bg);
		color: var(--fg);
		-webkit-font-smoothing: antialiased;
	}

	body {
		margin: 0;
		min-height: 100vh;
	}

	main {
		display: flex;
		justify-content: center;
		min-height: 100vh;
	}

	.page {
		width: 100%;
		max-width: var(--max);
		padding: 6rem var(--page-margin) 0;
	}

	header {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		margin-bottom: 3rem;
	}

	h1 {
		margin: 0;
		font-size: 1.875rem;
		font-weight: 500;
		letter-spacing: -0.02em;
		line-height: 1.2;
	}

	.tagline {
		margin: 0;
		color: var(--muted);
		font-size: 1rem;
		font-weight: 400;
		text-wrap: pretty;
	}

	.sections {
		display: flex;
		flex-direction: column;
		gap: 3rem;
		padding-bottom: 5rem;
	}

	section h2 {
		margin: 0 0 1rem;
		font-size: 0.875rem;
		font-weight: 400;
		color: var(--muted);
	}

	.work-list,
	.misc-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.work-item {
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 0.75rem 1rem;
		align-items: start;
		padding: 1rem 0 1.35rem;
		box-shadow: inset 0 0.5px 0 var(--border);
		line-height: 1.35;
		text-decoration: none;
		color: inherit;
		position: relative;
	}

	a.work-item.is-link {
		cursor: pointer;
		transition:
			background-color 160ms ease,
			box-shadow 160ms ease,
			padding 160ms ease,
			margin 160ms ease,
			border-radius 160ms ease;
	}

	a.work-item.is-link:hover,
	a.work-item.is-link:focus-visible {
		background: var(--accent-hover);
		margin-inline: -1rem;
		padding-inline: 1rem;
		border-radius: 0.5rem;
		box-shadow: none;
		outline: none;
	}

	a.work-item.is-link:hover .role-title,
	a.work-item.is-link:focus-visible .role-title {
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--muted) 55%, transparent);
		text-decoration-thickness: 0.5px;
		text-underline-offset: 4px;
	}

	a.work-item.is-link:hover .arrow,
	a.work-item.is-link:focus-visible .arrow {
		opacity: 1;
		color: var(--fg);
	}

	.org {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		min-width: 0;
	}

	.mark {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.125rem;
		height: 1.125rem;
		border-radius: 0.25rem;
		font-size: 0.5625rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--fg);
		background: color-mix(in srgb, var(--fg) 8%, transparent);
		flex-shrink: 0;
	}

	.org-name {
		font-weight: 500;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.roles {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.role-row {
		display: flex;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.15rem 0;
	}

	.role-main {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 0.75rem;
		min-width: 0;
	}

	.role-title {
		font-weight: 500;
		text-wrap: balance;
	}

	.role-note {
		color: var(--muted);
		opacity: 0.75;
	}

	.dates {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		min-width: 5.5rem;
		text-align: right;
	}

	.arrow {
		display: none;
		position: absolute;
		right: 0.75rem;
		top: 50%;
		transform: translateY(-50%);
		color: var(--muted);
		opacity: 0;
		transition:
			opacity 160ms ease,
			color 160ms ease;
	}

	.muted-section .work-item,
	.muted-section .misc-list {
		color: color-mix(in srgb, var(--fg) 72%, transparent);
	}

	.misc-list li {
		display: flex;
		align-items: flex-start;
		gap: 0.75rem;
		padding: 0.4rem 0;
		font-size: 0.875rem;
		line-height: 1.5;
	}

	.misc-year {
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
		min-width: 2.75rem;
	}

	.misc-body {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0.75rem;
		min-width: 0;
	}

	.misc-title {
		text-wrap: pretty;
	}

	.misc-source {
		color: var(--muted);
		opacity: 0.75;
	}

	.dock {
		position: sticky;
		bottom: 0;
		display: flex;
		justify-content: flex-start;
		padding: calc(var(--page-margin) * 1.5) 0 calc(var(--page-margin) / 1.25);
		margin-inline: calc(var(--page-margin) * -0.25);
		background-image: linear-gradient(
			to bottom,
			rgb(var(--background-rgb) / 0),
			rgb(var(--background-rgb) / 0.9),
			rgb(var(--background-rgb) / 1)
		);
	}

	.dock-group {
		display: flex;
		align-items: center;
		gap: 0.35rem;
	}

	.dock a {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.4rem;
		border-radius: 0.25rem;
		color: var(--fg);
		text-decoration: none;
		transition: background-color 140ms ease;
	}

	.dock a:hover,
	.dock a:focus-visible {
		background: var(--accent-hover);
		outline: none;
	}

	.reveal {
		opacity: 0;
		filter: blur(6px);
		transform: translateY(12px) scale(0.995);
		transform-origin: 50% 25%;
		animation: reveal-in 700ms cubic-bezier(0.22, 1, 0.36, 1) forwards;
		animation-delay: var(--reveal-delay, 0ms);
	}

	@keyframes reveal-in {
		to {
			opacity: 1;
			filter: blur(0);
			transform: translateY(0) scale(1);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.reveal {
			opacity: 1;
			filter: none;
			transform: none;
			animation: none;
		}

		a.work-item.is-link,
		.dock a,
		.arrow {
			transition: none;
		}
	}

	@media (min-width: 768px) {
		.work-item {
			grid-template-columns: 8.5rem 1fr 1.25rem;
			padding-bottom: 1rem;
		}

		.arrow {
			display: flex;
			align-items: center;
			justify-content: center;
		}

		a.work-item.is-link:hover .arrow,
		a.work-item.is-link:focus-visible .arrow {
			right: 1rem;
		}

		.role-note {
			display: inline;
		}
	}

	@media (max-width: 540px) {
		.page {
			padding-top: 3.5rem;
		}

		.work-item {
			grid-template-columns: 1fr;
			gap: 0.5rem;
		}

		.role-row {
			flex-direction: column;
			gap: 0.15rem;
		}

		.dates {
			text-align: left;
			min-width: 0;
		}

		.role-note {
			display: none;
		}
	}
</style>

{
  "name": "rtikhonov.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:docs": "node scripts/check-docs.mjs",
    "check": "npm run check:docs && astro check",
    "build": "astro build",
    "preview": "astro build && NODE_OPTIONS=\"--dns-result-order=ipv4first\" wrangler dev",
    "deploy": "npm run check:docs && astro build && NODE_OPTIONS=\"--dns-result-order=ipv4first\" wrangler deploy",
    "deploy:test": "astro build && NODE_OPTIONS=\"--dns-result-order=ipv4first\" wrangler deploy --env test",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@tabler/icons": "^3.45.0",
    "astro": "^7.1.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.2.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.112.0"
  }
}

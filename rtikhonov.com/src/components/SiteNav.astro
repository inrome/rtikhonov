---
import { INSPIRATION_ENABLED, NAV_ITEMS } from "../consts";

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
	href === "/" ? path === "/" : path.startsWith(href);

// Hide the whole chrome when Inspiration is off — Home alone looks odd on a one-pager.
const showNav = INSPIRATION_ENABLED && NAV_ITEMS.length > 0;
---

{
	showNav && (
		<nav class="site-nav" aria-label="Site">
			{NAV_ITEMS.map((item) => (
				<a href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
					{item.label}
				</a>
			))}
		</nav>
	)
}
